# Polygon Amoy RPC endpoint used for read-only calls from the browser
VITE_AMOY_RPC=

# Optional override. The address+ABI in ../shared/DecentraPay.json (written by
# contracts/scripts/deploy.js) is the default source of truth — only set this
# to point the app at a different deployment without touching that file.
VITE_CONTRACT_ADDRESS=

# WebSocket URL of the terminal/ service's POS/display feed. Defaults to
# ws://localhost:8080 if unset — only needed if you changed terminal/.env's
# WS_PORT away from 8080.
VITE_TERMINAL_WS_URL=
