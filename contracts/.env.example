# RPC endpoint for Polygon Amoy testnet (e.g. an Alchemy or Infura URL)
AMOY_RPC=

# Private key of the deployer wallet, funded with test MATIC — never commit a real value
DEPLOYER_KEY=

# Address to grant merchant status to (setMerchant) and register the terminal
# under (registerTerminal). The merchant's own wallet address.
MERCHANT_ADDRESS=

# Private key of the merchant's wallet — used ONLY so scripts/deploy.js can sign
# registerTerminal() as the merchant. Optional: omit it and the script prints the
# exact manual step instead. Use a disposable test wallet only, never a real key.
MERCHANT_KEY=

# Address to register as a terminal. Must match the wallet address derived from
# terminal/'s TERMINAL_KEY.
TERMINAL_ADDRESS=

# PolygonScan API key, for scripts/verify.js. Free at https://polygonscan.com/myapikey
POLYGONSCAN_API_KEY=
